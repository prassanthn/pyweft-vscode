{
  "name": "pyweft",
  "displayName": "PyWeft",
  "description": "Language support for PyWeft .weft components: XML templates with Python code-behind.",
  "version": "0.2.2",
  "publisher": "prassanthn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prassanthn/pyweft-vscode.git"
  },
  "homepage": "https://github.com/prassanthn/PyWeft",
  "bugs": {
    "url": "https://github.com/prassanthn/pyweft-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "pyweft",
    "weft",
    "python",
    "ui",
    "pyodide"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "ms-python.python"
  ],
  "contributes": {
    "languages": [
      {
        "id": "weft",
        "aliases": [
          "PyWeft",
          "weft"
        ],
        "extensions": [
          ".weft"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "weft",
        "scopeName": "source.weft",
        "path": "./syntaxes/weft.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.python": "python",
          "meta.embedded.line.python": "python",
          "meta.embedded.block.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "weft",
        "path": "./snippets/weft.json"
      }
    ],
    "commands": [
      {
        "command": "pyweft.showVirtualPython",
        "title": "PyWeft: Show Virtual Python Document"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "pretest": "npm run compile",
    "test": "node test/tokenize.mjs && node --test test/virtual.mjs",
    "test:e2e": "node test/e2e/run.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  }
}
