{
  "Component file": {
    "prefix": "weft",
    "description": "A complete .weft component: template plus code block",
    "body": [
      "<template>",
      "  <div class=\"${1:${TM_FILENAME_BASE}}\">",
      "    $0",
      "  </div>",
      "</template>",
      "",
      "<code>",
      "${2:count}: ${3:int} = ${4:0}",
      "",
      "def ${5:increment}(self):",
      "    self.$2 += 1",
      "</code>",
      ""
    ]
  },
  "Template block": {
    "prefix": "template",
    "body": ["<template>", "  $0", "</template>"]
  },
  "Code block": {
    "prefix": "code",
    "body": ["<code>", "$0", "</code>"]
  },
  "If": {
    "prefix": "if",
    "description": "<If cond=\"...\">",
    "body": ["<If cond=\"${1:condition}\">", "  $0", "</If>"]
  },
  "If / Else": {
    "prefix": "ifelse",
    "body": [
      "<If cond=\"${1:condition}\">",
      "  $2",
      "</If>",
      "<Else>",
      "  $0",
      "</Else>"
    ]
  },
  "ElseIf": {
    "prefix": "elseif",
    "body": ["<ElseIf cond=\"${1:condition}\">", "  $0", "</ElseIf>"]
  },
  "Else": {
    "prefix": "else",
    "body": ["<Else>", "  $0", "</Else>"]
  },
  "For": {
    "prefix": "for",
    "description": "<For each=\"item in items\" key=\"...\">",
    "body": [
      "<For each=\"${1:item} in ${2:items}\" key=\"$1['${3:id}']\">",
      "  $0",
      "</For>"
    ]
  },
  "For with index": {
    "prefix": "fori",
    "body": [
      "<For each=\"${1:item} in ${2:items}\" key=\"$1['${3:id}']\" index=\"${4:i}\">",
      "  $0",
      "</For>"
    ]
  },
  "Bound input": {
    "prefix": "bind",
    "description": "<input @bind=\"field\" />",
    "body": "<input @bind=\"${1:field}\" placeholder=\"${2}\" />"
  },
  "Button with click": {
    "prefix": "click",
    "body": "<button @click=\"${1:handler}\">${2:label}</button>"
  },
  "Child component": {
    "prefix": "comp",
    "description": "Use a sibling component with a prop and an event",
    "body": "<${1:ChildName} :${2:item}=\"${3:item}\" @${4:remove}=\"${5:remove}(event)\" />"
  },
  "Interpolation": {
    "prefix": "{{",
    "body": "{{ ${1:expr} }}"
  },
  "State field": {
    "prefix": "state",
    "body": "${1:name}: ${2:str} = ${3:\"\"}"
  },
  "Handler method": {
    "prefix": "def",
    "body": ["def ${1:handler}(self${2}):", "    ${0:pass}"]
  },
  "Computed property": {
    "prefix": "prop",
    "body": ["@property", "def ${1:name}(self):", "    return ${0:...}"]
  },
  "Emit event": {
    "prefix": "emit",
    "body": "self.emit(\"${1:event}\"${2:, payload})"
  },
  "on_init": {
    "prefix": "oninit",
    "body": ["def on_init(self):", "    ${0:pass}"]
  },
  "on_dispose": {
    "prefix": "ondispose",
    "body": ["def on_dispose(self):", "    ${0:pass}"]
  }
}
